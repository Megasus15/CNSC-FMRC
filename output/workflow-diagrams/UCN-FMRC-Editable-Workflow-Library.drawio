        </mxCell>
        <mxCell id="purpose" value="Use this map to locate the independent workflow files. It does not replace any detailed end-to-end process." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#273142;fontFamily=Montserrat;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
