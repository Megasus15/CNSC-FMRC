        <mxCell id="rules" value="KEY RULES&#10;Default schedules, day-specific changes and existing reservations are checked by current scheduling rules.&#10;Calendar changes do not silently rebook existing Customers.&#10;Both operator portals read the same shared calendar; personal Settings do not alter it." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#273142;fontFamily=Montserrat;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
