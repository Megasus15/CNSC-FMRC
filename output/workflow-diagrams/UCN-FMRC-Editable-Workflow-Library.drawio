        <mxCell id="rules" value="KEY RULES&#10;Application alone does not create an active Staff session.&#10;Admin approval rechecks identifiers; a username or Gmail taken after submission blocks creation.&#10;Requests are subject to CAPTCHA, rate limits and installed storage." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#273142;fontFamily=Montserrat;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
