        <mxCell id="rules" value="KEY RULES&#10;Reports derive totals from orders, payments, walk-in sales and refunds; generating a report does not mutate revenue.&#10;Inventory and Product Stock categories retain their existing period and data rules.&#10;Letterhead settings and print layout are shared; previews do not submit new transactions." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#273142;fontFamily=Montserrat;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
