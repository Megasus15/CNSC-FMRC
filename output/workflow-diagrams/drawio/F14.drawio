        <mxCell id="rules" value="KEY RULES&#10;Returning from checkout, a screenshot or a manually typed reference does not establish provider-managed payment.&#10;Pending or uncertain attempts are checked before retry; duplicate or late payments require recorded review.&#10;Cash on pickup bypasses hosted checkout. Custom advance cash follows F17 instead." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#273142;fontFamily=Montserrat;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
