        <mxCell id="rules" value="KEY RULES&#10;Unresolved payment, cancellation, refund or custom-production holds prevent collection.&#10;Custom orders must already have full payment and ready production; normal pickup cash is recorded at collection.&#10;Delivery orders use F16 instead. A Customer cannot manually force completion through the retired receive action." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#273142;fontFamily=Montserrat;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
