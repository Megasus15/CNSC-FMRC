<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --------------------------------------------------------------------------
    # 1. Pass Authorization Headers for Laravel Sanctum / Bearer Tokens
    # --------------------------------------------------------------------------
    SetEnvIfNoCase ^Authorization$ "(.+)" HTTP_AUTHORIZATION=$1
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # --------------------------------------------------------------------------
    # 2. Block Direct Access to Sensitive Files & Folders
    #
    # `storage` is deliberately NOT blocked as a whole. Section 3 rewrites
    # /storage/* into backend/storage/app/public/*, and mod_rewrite re-runs this
    # ruleset on that internal redirect, so a blanket ^backend/storage block
    # answered every uploaded photo, attachment and video with 403 Forbidden.
    # Only the public disk is reachable, only as a file, and never as code.
    # --------------------------------------------------------------------------
    RewriteRule ^backend/(\.env|config|database|app|bootstrap|vendor) - [F,L]
    RewriteRule ^backend/storage/app/public/.*\.(php[0-9s]?|phtml|phar|cgi|pl|py|sh|ini|htaccess)$ - [F,L,NC]
    RewriteRule ^backend/storage/app/public/(.*/)?$ - [F,L]
    RewriteRule ^backend/storage/app/public/ - [L]
    RewriteRule ^backend/storage/ - [F,L]
    RewriteRule ^\.env - [F,L]
    RewriteRule ^\.git - [F,L]

    # --------------------------------------------------------------------------
    # 3. Route Backend Requests to Laravel
    # --------------------------------------------------------------------------
    RewriteRule ^\.well-known/assetlinks\.json$ backend/public/index.php [QSA,L]
    RewriteRule ^api/(.*)$ backend/public/index.php [QSA,L]
    RewriteRule ^api$ backend/public/index.php [QSA,L]
    RewriteRule ^reset-password(.*)$ backend/public/index.php [QSA,L]
    RewriteRule ^appointments/verify/(.*)$ backend/public/index.php [QSA,L]
    # Uploaded files (appointment attachments, review photos/videos, return
    # evidence). Section 2 keeps everything except this folder locked down.
    RewriteRule ^storage/(.*)$ backend/storage/app/public/$1 [L]

    # --------------------------------------------------------------------------
    # 4. Hide .html Extension: Redirect .html requests to clean URL
    # Example: /home-page/main.html -> /home-page/main
    # --------------------------------------------------------------------------
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.html[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # --------------------------------------------------------------------------
    # 5. Serve .html Files Behind the Clean URL
    # Example: /home-page/main loads /home-page/main.html internally
    # --------------------------------------------------------------------------
    # Two isolated apps, served directly from allowlisted source folders.
    # END prevents another rewrite pass from canonicalizing the internal source URL.
    RewriteRule ^apps/(customer|team)/?$ apps/$1/index.html [END]
    RewriteRule ^apps/(customer|team)/(install|offline|index)/?$ apps/$1/$2.html [END]
    RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
    RewriteRule ^apps/customer/(home-page|about-page|services-page|products-page|contact-page|customer-auth)/([A-Za-z0-9_-]+)/?$ $1/$2.html [END]
    RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
    RewriteRule ^apps/team/(admin-page|staff-page|admin-auth)/([A-Za-z0-9_-]+)/?$ $1/$2.html [END]
    RewriteRule ^apps/customer/(home-page|about-page|services-page|products-page|contact-page|customer-auth)/([A-Za-z0-9_-]+\.html)$ $1/$2 [END]
    RewriteRule ^apps/team/(admin-page|staff-page|admin-auth)/([A-Za-z0-9_-]+\.html)$ $1/$2 [END]
    RewriteCond %{DOCUMENT_ROOT}/$1/$2 -f
    RewriteCond $2 !(^|/)\.{1,2}(/|$)
    RewriteRule "^apps/(?:customer|team)/(home-page|about-page|services-page|products-page|contact-page|customer-auth|admin-page|staff-page|admin-auth|images)/([A-Za-z0-9 _%./-]+\.(?:css|js|png|jpe?g|svg|webp|ico|woff2?|mp4|gif))$" $1/$2 [END,NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^apps/(?:customer|team)/ - [R=404,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*?)/?$ $1.html [L]

</IfModule>

AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|worker\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 6. Enable GZIP Compression for Fast Loading Speed
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 6b. Brotli, where the host has it. Roughly 15-20% smaller than gzip on the two
# large text assets (main.css and main.js), and a no-op on hosts without the
# module thanks to the IfModule guard. mod_brotli takes precedence over
# mod_deflate when both are enabled, so section 6 stays as the fallback.
# ------------------------------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 7. Browser Caching for Instant Loading on Return Visits
#
# `text/javascript` is listed alongside `application/javascript` on purpose:
# current Apache 2.4 mime.types labels .js as text/javascript, so on such a host
# the application/* line alone gave main.js no freshness lifetime at all and the
# browser revalidated it on every one of the four customer pages. Every linked
# asset carries a hand-bumped ?v= query, so a long lifetime is safe.
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
