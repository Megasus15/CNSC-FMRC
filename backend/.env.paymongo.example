# Copy these values into the private backend environment. Never put secrets in HTML.
PAYMENT_GATEWAY=paymongo
PAYMONGO_ENABLED=false
# Use qrph for GCash scanning. Set gcash only after direct GCash activation.
PAYMONGO_CHECKOUT_METHOD=qrph
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# APP_URL and FRONTEND_URL must be the official HTTPS origin.
# Use test keys only in a separate staging environment.
