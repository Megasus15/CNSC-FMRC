# Only for the separate staging.ucn-fabmanlab.com website.
# Rename this file to .env, then replace the two private password placeholders.
APP_NAME=FMRC
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.ucn-fabmanlab.com
FRONTEND_URL=https://staging.ucn-fabmanlab.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u799987132_fmrc_staging
DB_USERNAME=u799987132_fmrc_stage
DB_PASSWORD="REPLACE_WITH_STAGING_DATABASE_PASSWORD"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LOG_CHANNEL=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12
MAIL_MAILER=log
MAIL_FROM_ADDRESS=testing@staging.ucn-fabmanlab.com
MAIL_FROM_NAME=FMRC
CLOUDFLARE_TURNSTILE_ENABLED=false
PAYMENT_GATEWAY=manual
GCASH_AUTO_CONFIRM=false
PAYMONGO_TEST_SIMULATOR=false
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

PWA_PUSH_ENABLED=false
PWA_VAPID_SUBJECT=https://staging.ucn-fabmanlab.com
PWA_VAPID_PUBLIC_KEY=
PWA_VAPID_PRIVATE_KEY=

# One-time setup: set true after both passwords are filled in.
# The setup script disables this and clears the test-password entry on success.
FMRC_STAGING_SETUP_ENABLED=false
FMRC_STAGING_TEST_PASSWORD="REPLACE_WITH_NEW_TEST_LOGIN_PASSWORD"
